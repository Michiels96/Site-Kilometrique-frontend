<nav class="navbar navbar-expand-md navbar-dark bg-dark mb-4">
    <div class="container-fluid">
      <div style="float: left;">
        <p>
          <a class="navbar-brand" [routerLink]="componentAffiche != 'componentConnexion' && componentAffiche != 'componentInscription' ? '/' : null" *ngIf="connecte || this.componentAffiche == 'component404'" style="font-family: source_sans_proregular;font-size: 30px;">Site Kilométrique</a>
          <a class="navbar-brand" [routerLink]="componentAffiche != 'componentConnexion' && componentAffiche != 'componentInscription' ? '/' : null" *ngIf="!connecte && this.componentAffiche != 'component404'">Site Kilométrique - {{ 'nav.connectionPage' | translate }}</a> 
        </p>
      </div>
      
  
      <div style="display: inline-flex; float: right;">
        <div class="dropdown" style="display: inline-flex; float: right; margin-right: 10px;">
          <button class="btn btn-link p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <img *ngIf="language == 'fr'" src="../../assets/svg/fr.svg" alt="Français" style="width: 30px;"/>
            <img *ngIf="language == 'en'" src="../../assets/svg/en.svg" alt="English" style="width: 30px;"/>
            <img *ngIf="language == 'nl'" src="../../assets/svg/nl.svg" alt="Nederlands" style="width: 30px;"/>
          </button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" (click)="changeLanguage('fr')"><img src="../../assets/svg/fr.svg" style="width: 20px; margin-right: 8px;"/> Français</a></li>
            <li><a class="dropdown-item" (click)="changeLanguage('en')"><img src="../../assets/svg/en.svg" style="width: 20px; margin-right: 8px;"/> English</a></li>
            <li><a class="dropdown-item" (click)="changeLanguage('nl')"><img src="../../assets/svg/nl.svg" style="width: 20px; margin-right: 8px;"/> Nederlands</a></li>
          </ul>
        </div>

        <ul class="navbar-nav me-auto mb-2 mb-md-0" *ngIf="!connecte && this.componentAffiche != 'component404'" style="height: 30px;font-family: source_sans_proregular;font-size: 20px;">
          <li class="nav-item" *ngIf="componentAffiche !== 'componentConnexion'">
            <a class="nav-link active" aria-current="page" routerLink="/connexion" (click)="this.componentAffiche = 'componentConnexion'">{{ 'nav.connection' | translate }}</a>
          </li>
          <li class="nav-item" *ngIf="componentAffiche !== 'componentInscription' && this.componentAffiche != 'component404'">
            <a class="nav-link active" aria-current="page" routerLink="/inscription" (click)="this.componentAffiche = 'componentInscription'">{{ 'nav.register' | translate }}</a>
          </li>
        </ul>

        <ul class="navbar-nav me-auto mb-2 mb-md-0 logo" *ngIf="connecte && componentAffiche !== 'componentProfil'">
          <li class="nav-item">
            <!-- <a class="nav-link active" aria-current="page" routerLink="/connexion" (click)="deconnexion()">Déconnexion</a> -->
            <img src="../../assets/svg/person-circle.svg" alt="profil" (click)="modifierProfil()"/>
          </li>
        </ul>
        <ul class="navbar-nav me-auto mb-2 mb-md-0 logo" *ngIf="connecte">
          <li class="nav-item">
            <!-- <a class="nav-link active" aria-current="page" routerLink="/connexion" (click)="deconnexion()">Déconnexion</a> -->
            <img src="../../assets/svg/box-arrow-up.svg" alt="déconnexion" routerLink="/connexion" (click)="deconnexion()"/>
          </li>
        </ul>
      </div>
    </div>
  </nav>

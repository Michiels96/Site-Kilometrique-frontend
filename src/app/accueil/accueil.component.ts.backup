import { HttpClient } from '@angular/common/http';
import { Component, OnDestroy, OnInit } from '@angular/core';
import { Emitters } from '../emitters/emitters';
import { Subscription } from 'rxjs';
import { UtilisateurService } from '../services/utilisateur.service';
import { LanguageService } from '../services/language.service';
import { TranslateService } from '@ngx-translate/core';
import { ReloadService } from '../services/component-reload.service';

@Component({
  selector: 'app-accueil',
  templateUrl: './accueil.component.html',
  styleUrls: ['./accueil.component.css']
})
export class AccueilComponent implements OnInit, OnDestroy {
  private reloadSubscription: Subscription;

  // language terms
  admin_status: string;
  message: string;
  nav_history_menu_title: string;
  nav_history_menu_legend: string;
  nav_history_menu_button: string;
  vehicles_menu_title: string;
  vehicles_menu_legend: string;
  vehicles_menu_button: string;
  brands_menu_title: string;
  brands_menu_legend: string;
  brands_menu_button: string;
  users_menu_title: string;
  users_menu_legend: string;
  users_menu_button: string;
  stats_menu_title: string;
  stats_menu_legend: string;
  stats_menu_button: string;
  down_menu_title: string;
  down_menu_legend: string;
  down_menu_button: string;
  footer: string;

  constructor(private httpClient: HttpClient, private utilisateurService: UtilisateurService, private reloadService: ReloadService, private languageService: LanguageService, private translateService: TranslateService){}

  ngOnInit(): void {
    Emitters.componentAffiche.emit("componentAccueil");
    // Observable to reload from 'nav' component when there is a language change
    this.reloadSubscription = this.reloadService.getReloadObservable().subscribe((reload) => {
      if (reload) {
        this.setLanguageTerms();
      }
    });
    this.setLanguageTerms();
  }

  setLanguageTerms(){
    this.translateService.get('accueil.admin_status').subscribe((res: string) => {
      this.admin_status = res;
    });

    this.translateService.get('accueil.nav_history_menu_title').subscribe((res: string) => {
      this.nav_history_menu_title = res;
    });

    this.translateService.get('accueil.nav_history_menu_legend').subscribe((res: string) => {
      this.nav_history_menu_legend = res;
    });

    this.translateService.get('accueil.nav_history_menu_button').subscribe((res: string) => {
      this.nav_history_menu_button = res;
    });

    this.translateService.get('accueil.vehicles_menu_title').subscribe((res: string) => {
      this.vehicles_menu_title = res;
    });

    this.translateService.get('accueil.vehicles_menu_legend').subscribe((res: string) => {
      this.vehicles_menu_legend = res;
    });

    this.translateService.get('accueil.vehicles_menu_button').subscribe((res: string) => {
      this.vehicles_menu_button = res;
    });

    this.translateService.get('accueil.brands_menu_title').subscribe((res: string) => {
      this.brands_menu_title = res;
    });

    this.translateService.get('accueil.brands_menu_legend').subscribe((res: string) => {
      this.brands_menu_legend = res;
    });

    this.translateService.get('accueil.brands_menu_button').subscribe((res: string) => {
      this.brands_menu_button = res;
    });

    this.translateService.get('accueil.users_menu_title').subscribe((res: string) => {
      this.users_menu_title = res;
    });

    this.translateService.get('accueil.users_menu_legend').subscribe((res: string) => {
      this.users_menu_legend = res;
    });

    this.translateService.get('accueil.users_menu_button').subscribe((res: string) => {
      this.users_menu_button = res;
    });

    this.translateService.get('accueil.stats_menu_title').subscribe((res: string) => {
      this.stats_menu_title = res;
    });

    this.translateService.get('accueil.stats_menu_legend').subscribe((res: string) => {
      this.stats_menu_legend = res;
    });

    this.translateService.get('accueil.stats_menu_button').subscribe((res: string) => {
      this.stats_menu_button = res;
    });

    this.translateService.get('accueil.down_menu_title').subscribe((res: string) => {
      this.down_menu_title = res;
    });

    this.translateService.get('accueil.down_menu_legend').subscribe((res: string) => {
      this.down_menu_legend = res;
    });

    this.translateService.get('accueil.down_menu_button').subscribe((res: string) => {
      this.down_menu_button = res;
    });

    this.translateService.get('accueil.footer').subscribe((res: string) => {
      this.footer = res;
    });

    if (this.languageService.getSelectedLanguage() == 'fr'){
      this.message = "Bienvenue "+this.utilisateurService.getInfoUtilisateur().prenom+" "+this.utilisateurService.getInfoUtilisateur().nom;
    }

    if (this.languageService.getSelectedLanguage() == 'en'){
      this.message = "Welcome "+this.utilisateurService.getInfoUtilisateur().prenom+" "+this.utilisateurService.getInfoUtilisateur().nom;
    }
  }

  ngOnDestroy(): void{
    Emitters.componentAffiche.emit("");
    // delete the observable to avoid component memory leak
    if (this.reloadSubscription) {
      this.reloadSubscription.unsubscribe();
    }
  }

  checkAdminStatus(){
    if(this.utilisateurService.getInfoUtilisateur().estAdmin){
      return true;
    }
    return false;
  }
}
